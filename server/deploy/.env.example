# Copy to .env and fill in. Never commit the real .env.

# --- What the public root serves ---
#   site  — the Halogen devlog (default): a real site the operator area hides behind
#   decoy — the old 4PDA camouflage page, for a panel that is never published
#   login — the operator login form itself, no cover at all
PODKOP_SERVER_ROOT=site

# Name and tagline of the public site. Keep them matching the domain it is
# served from — a devlog whose title has nothing to do with the address is a
# weaker cover than one that lines up.
PODKOP_SERVER_SITE_NAME=Backfire
PODKOP_SERVER_SITE_TAGLINE=an open-city street racer on s&box

# Let search engines index the public site. Off by default: the operator area is
# never indexable either way, but a site nobody crawls is also a site nobody
# stumbles onto.
PODKOP_SERVER_SITE_INDEXING=false

# --- Where the panel listens ---
# Host address the container port is published on. It is NEVER published on
# 0.0.0.0 — browser access is supposed to arrive through nginx (profile
# "public") or cloudflared (profile "tunnel").
#   127.0.0.1  — the front end / tunnel runs on this host (default)
#   172.17.0.1 — Xray or AmneziaWG run in containers and reach the host over the docker bridge
#   10.8.1.1   — the AmneziaWG address of the host (routers pull over the tunnel)
PODKOP_SERVER_BIND=127.0.0.1

# Trust X-Forwarded-For / CF-Connecting-IP. REQUIRED behind nginx or a
# Cloudflare tunnel — otherwise every visitor looks like the same address and
# one failed login locks out everyone. HARMFUL when the panel is exposed
# directly: the headers can be forged to dodge the throttle or to lock out
# somebody else.
PODKOP_SERVER_TRUSTED_PROXY=false

# --- Operator area ---
# Secret base path. There is no link to it from the public site; keep it random.
PODKOP_SERVER_ADMIN_PATH=/manage-CHANGE-ME/
PODKOP_SERVER_ADMIN_USER=admin

# Base URL routers and phone apps use to reach this server. Set it when the
# panel lives on its own hostname behind Cloudflare Access: links are otherwise
# built from the host you are browsing, and machines fetching that host get the
# Access login instead of their key.
PODKOP_SERVER_PUBLIC_URL=https://example.org

# Optional dedicated hostname for the operator area: its root redirects to the
# panel instead of showing the devlog. Use it only for a hostname that already
# sits behind Cloudflare Access — whoever reaches it learns the secret path.
#PODKOP_SERVER_ADMIN_HOST=panel.example.com
# Take the operator area off the internet: it then answers only on a loopback
# Host — reach it with `ssh -L 8080:127.0.0.1:8080 vps`, then
# http://127.0.0.1:8080/<admin path>/ — and on ADMIN_HOST if one is set.
# Everything else gets the site's 404, so the secret path is not confirmed.
# Without this the operator area answers on every hostname the server is reached
# by: putting one hostname behind Cloudflare Access protects only that hostname,
# and the same path stays open on the public one.
#PODKOP_SERVER_ADMIN_LOCAL_ONLY=true
# Required. Use a long random password — this form faces the internet.
PODKOP_SERVER_ADMIN_PASSWORD=CHANGE-ME-long-random

# Session lifetime and login throttle.
PODKOP_SERVER_SESSION_TTL=12h
PODKOP_SERVER_LOGIN_MAX_FAILS=5
PODKOP_SERVER_LOGIN_LOCKOUT=15m

# Optional: override the built-in 4PDA decoy with your own static site
# (only used when PODKOP_SERVER_ROOT=decoy).
#PODKOP_SERVER_DECOY_DIR=/decoy

# --- Cloudflare tunnel (compose profile "tunnel") ---
# Token from the Cloudflare Zero Trust dashboard.
#CLOUDFLARE_TUNNEL_TOKEN=

# --- 3x-UI integration (optional, compose profile "xui") ---
# Leave XUI_USERNAME/PASSWORD empty to disable and issue keys manually instead.
# XUI_BASE_URL is set in docker-compose.yml to the internal 3x-ui service.
XUI_USERNAME=
XUI_PASSWORD=
# Inbound id (in 3x-UI) on which new client keys are created.
XUI_INBOUND_ID=1
# Port the Xray inbound listens on — published as-is, so it must equal the port
# of the inbound created in 3x-UI. 443 looks like ordinary HTTPS, which is the
# point of Reality; change it only if something else on the VPS owns 443.
XRAY_PORT=443
# Public host/IP or domain that goes into generated vless links (how clients
# reach your Xray inbound). Usually your VPS domain or IP.
XUI_PUBLIC_HOST=your-domain.example
# Host address 3x-UI's own web interface is published on. Loopback by default:
# reach it with `ssh -L 2053:127.0.0.1:2053 vps`. Do not put 0.0.0.0 here — to
# open it from outside, route a hostname to 3x-ui:2053 through the tunnel and
# cover that hostname with a Cloudflare Access policy.
XUI_UI_BIND=127.0.0.1
# XTLS flow for newly issued clients. "xtls-rprx-vision" is the fast path on a
# TCP inbound (splice, far less CPU — worth it on a single vCPU). Applied only
# on TCP inbounds: Vision does not exist on gRPC or WebSocket, and the panel
# issues those keys without flow and says so in the log.
#XUI_CLIENT_FLOW=xtls-rprx-vision

# Directory of static assets served by the `media` profile — the screenshots and
# video too big to ship inside the binary. Route media.example.com to
# http://media:80 in the tunnel and leave that hostname proxied: a grey-cloud
# asset host would make every reader of the site connect to the VPS directly.
#MEDIA_DIR=./media-files
